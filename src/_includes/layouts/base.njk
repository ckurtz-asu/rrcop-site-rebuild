        <img src="/img/uploads/migrated/rrcop-logo.png" alt="Regulated Research Community of Practice" class="brand-logo">
      </a>
      <nav aria-label="Primary">
        <a href="/">Home</a>
        <a href="/monthly-webinars/">Monthly Webinars</a>
        <a href="/resources/">Resources</a>
        <a href="/compliance/">Compliance</a>
