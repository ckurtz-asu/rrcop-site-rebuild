<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Regulated Research Community of Practice</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">
        <img src="/img/uploads/migrated/rrcop-logo.png" alt="Regulated Research Community of Practice" class="brand-logo">
      </a>
      <button type="button" id="nav-sidebar-toggle" aria-expanded="false" aria-controls="primary-nav">
        <span aria-hidden="true">☰</span> Menu
      </button>
      {% from "nav-macro.njk" import renderItem %}
      <nav aria-label="Primary" id="primary-nav">
        <ul class="nav-tree">
          {% for item in nav %}
            {{ renderItem(item, page.url) }}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>This project is led by Carolyn Ellis, Erik Deumens, Laura Raderman with support from
        <a href="http://trustedci.org">TrustedCI.org</a>.</p>
      <p>Contact <a href="mailto:info@regulatedresearch.org">info@regulatedresearch.org</a> for more information on the project.</p>
      <p class="fine-print">This material is based upon activities supported by the National Science Foundation and
        Interagency Agreement #A2407-049-089-064206.0. Any opinions, recommendations, findings, or conclusions expressed
        are those of the author(s) and do not necessarily reflect the views of the National Science Foundation.</p>
      <p><a href="https://www.nsf.gov/awardsearch/showAward?AWD_ID=2409859&amp;HistoricalAwards=false">NSF Award #2409859</a></p>
      <p><a href="https://www.linkedin.com/company/rrcop/"><img src="/img/uploads/migrated/linkedin-icon.png" alt="RRCoP on LinkedIn" class="linkedin-icon"></a></p>
      <p class="test-banner">TEST BUILD — content structure demo, not the production site.</p>
    </div>
  </footer>

  <script>
    // Nav behavior:
    // 1. Each .nav-toggle button expands/collapses its own .nav-children
    //    independently -- unlike production, where a sibling branch's
    //    disclosure only opens by navigating into it.
    // 2. On load, auto-expand every ancestor branch of the current page so
    //    a visitor lands with their own location already visible in the tree.
    (function () {
      var nav = document.getElementById("primary-nav");
      if (!nav) return;

      nav.addEventListener("click", function (event) {
        var toggle = event.target.closest(".nav-toggle");
        if (!toggle) return;
        var item = toggle.closest(".nav-item");
        var expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        item.classList.toggle("is-open", !expanded);
      });

      var current = nav.querySelector('.nav-link[aria-current="page"]');
      if (current) {
        var node = current.closest(".nav-item");
        while (node) {
          node.classList.add("is-open");
          var toggle = node.querySelector(":scope > .nav-row > .nav-toggle");
          if (toggle) toggle.setAttribute("aria-expanded", "true");
          var parentList = node.parentElement;
          node = parentList ? parentList.closest(".nav-item") : null;
        }
      }

      var sidebarToggle = document.getElementById("nav-sidebar-toggle");
      if (sidebarToggle) {
        sidebarToggle.addEventListener("click", function () {
          var open = sidebarToggle.getAttribute("aria-expanded") === "true";
          sidebarToggle.setAttribute("aria-expanded", String(!open));
          nav.classList.toggle("is-open", !open);
        });
      }
    })();
  </script>
</body>
</html>
